<Window x:Class="WatermarkRemover.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:WatermarkRemover.App.Controls"
        mc:Ignorable="d"
        Title="AI 去水印"
        Width="1560"
        Height="940"
        MinWidth="1240"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Text="AI 去水印" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="选择图片，框选水印区域，开始处理。模型由程序自动自动判断，无需手动干预。" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Command="{Binding OpenImageCommand}"
                            Content="选择图片" />
                    <Button Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ProcessCommand}"
                            Content="开始处理" />
                    <Button Margin="12,0,0,0"
                            Command="{Binding SaveResultCommand}"
                            Content="保存结果" />
                </StackPanel>

                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0"
                        Background="{StaticResource AccentSoftBrush}"
                        Padding="14,12">
                    <DockPanel LastChildFill="True">
                        <ProgressBar Width="120"
                                     Height="6"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="14"
                                   Text="{Binding StatusMessage}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="框选水印位置" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="左键拖拽框出水印区域；右键可清空当前所有选区。" />
                    </StackPanel>

                    <controls:MaskEditorControl Grid.Row="1"
                                                SourceImage="{Binding SourceImage}"
                                                MaskImage="{Binding EditableMask, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="18,0,0,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="处理结果" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="结果会自动使用程序判断的合适模型生成，完成后直接保存即可。" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#FFF5F7F9"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ResultImage}"
                                   Stretch="Uniform" />

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="15"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="处理完成后的图片会显示在这里&#10;先选择图片，再框选水印位置。">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResult}"
                                                         Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
