<UserControl x:Class="WatermarkRemover.App.Controls.MaskEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             PreviewKeyDown="MaskEditorControl_OnPreviewKeyDown"
             PreviewMouseWheel="MaskEditorControl_OnPreviewMouseWheel">
    <Border Background="{StaticResource CanvasBackdropBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            ClipToBounds="True">
        <Grid>
            <Grid Margin="16">
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Grid x:Name="SurfaceGrid"
                          Width="1280"
                          Height="720"
                          ClipToBounds="True">
                        <Image x:Name="SourceImagePresenter"
                               Stretch="Fill" />
                        <Image x:Name="ImportedMaskPresenter"
                               Stretch="Fill"
                               Opacity="0.28"
                               IsHitTestVisible="False" />
                        <Canvas x:Name="SelectionSurface"
                                Background="Transparent"
                                MouseLeftButtonDown="SelectionSurface_OnMouseLeftButtonDown"
                                MouseMove="SelectionSurface_OnMouseMove"
                                MouseLeftButtonUp="SelectionSurface_OnMouseLeftButtonUp"
                                MouseRightButtonDown="SelectionSurface_OnMouseRightButtonDown">
                            <Canvas x:Name="CommittedSelectionLayer"
                                    IsHitTestVisible="False" />
                            <Canvas x:Name="BrushStrokeLayer"
                                    IsHitTestVisible="False" />
                            <Rectangle x:Name="PreviewRectangle"
                                       Visibility="Collapsed"
                                       IsHitTestVisible="False"
                                       Stroke="#FFF97316"
                                       StrokeThickness="3"
                                       StrokeDashArray="8 5"
                                       Fill="#40F97316" />
                        </Canvas>
                    </Grid>
                </Viewbox>
            </Grid>

            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="18"
                    Padding="10,8"
                    Background="#A612172A"
                    CornerRadius="12"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="编辑快捷键" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#E5E7EB"
                               FontSize="11"
                               Text="左键框选；Shift+左键补涂；Ctrl+Shift+左键擦除" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#E5E7EB"
                               FontSize="11"
                               Text="Ctrl+Z 撤销；[ / ] 调整笔刷；右键清空" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="PlaceholderPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="先选择一张图片" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#D1D5DB"
                           Text="左键框选；Shift+左键补涂；Ctrl+Shift+左键擦除；右键清空" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
